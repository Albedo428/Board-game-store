<Window x:Class="WpfApp1.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Меню" Height="540" Width="960"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="UserInfoText"/>
        </StatusBar>

        <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0">
            <Image x:Name="LogoImage" Height="64" Stretch="Uniform" Margin="0,0,0,8"/>

            <Menu HorizontalAlignment="Center">
                <MenuItem Header="ФАЙЛ">
                    <MenuItem Header="Обновить" Click="Refresh_Click"/>
                    <Separator/>
                    <MenuItem Header="Выйти из программы" Click="ExitApp_Click"/>
                </MenuItem>
                <MenuItem Header="СПРАВКА">
                    <MenuItem Header="О программе" Click="About_Click"/>
                    <MenuItem Header="Как работает программа" Click="Help_Click"/>
                </MenuItem>
                <MenuItem x:Name="UsersMenuItem" Header="ПОЛЬЗОВАТЕЛИ" Click="Users_Click"/>
            </Menu>

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Margin="40,0,40,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="НАСТОЛЬНЫЕ ИГРЫ" Style="{StaticResource NavButton}" Click="Games_Click"/>
                <Button Content="НАПИТКИ" Style="{StaticResource NavButton}" Click="Beverages_Click"/>
                <Button Content="УСЛУГИ" Style="{StaticResource NavButton}" Click="Services_Click"/>
                <Button Content="КЛИЕНТЫ" Style="{StaticResource NavButton}" Click="Customers_Click"/>
                <Button Content="ВЫХОД" Style="{StaticResource NavButton}" Click="Logout_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="МАГАЗИН" Style="{StaticResource Heading}" FontSize="64" HorizontalAlignment="Center"/>
            <TextBlock Text="НАСТОЛЬНЫХ ИГР" Style="{StaticResource Heading}" FontSize="64" HorizontalAlignment="Center"/>
            <TextBlock Text="В Ы Б Е Р И Т Е   Р А З Д Е Л   В   М Е Н Ю" Style="{StaticResource SubHeading}"
                       FontSize="15" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
