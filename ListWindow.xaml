<Window x:Class="WpfApp1.ListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Список" Height="660" Width="1080" MinHeight="460" MinWidth="780"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,16,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0" Style="{StaticResource Heading}" FontSize="36"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button x:Name="AddButton" Content="Добавить" Style="{StaticResource PrimaryButton}"
                    Width="130" Height="34" Margin="0,0,10,0" Click="Add_Click"/>
            <Button x:Name="EditButton" Content="Редактировать" Width="130" Height="34" Margin="0,0,10,0" Click="Edit_Click"/>
            <Button x:Name="DeleteButton" Content="Удалить" Width="130" Height="34" Click="Delete_Click"/>
        </StackPanel>

        <StackPanel x:Name="SearchPanel" Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="ПОИСК" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchBox" Width="320" Height="32" VerticalContentAlignment="Center"
                     KeyDown="SearchBox_KeyDown"/>
            <Button Content="Найти" Width="90" Height="32" Margin="8,0,0,0" Click="Search_Click"/>
            <Button Content="Сбросить" Width="90" Height="32" Margin="8,0,0,0" Click="Reset_Click"/>
        </StackPanel>

        <DataGrid x:Name="ItemsGrid" Grid.Row="3" Margin="0,14,0,14"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"/>

        <DockPanel Grid.Row="4">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
            <Button Content="Вернуться в меню" Width="180" Height="34"
                    HorizontalAlignment="Left" Click="Back_Click"/>
        </DockPanel>
    </Grid>
</Window>
