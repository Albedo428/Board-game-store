<Window x:Class="WpfApp1.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Справка" Height="560" Width="680"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="26,20,26,20">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Style="{StaticResource Heading}"
                   FontSize="32" Margin="0,0,0,16" TextWrapping="Wrap"/>
        <Button DockPanel.Dock="Bottom" Content="Закрыть" Width="130" Height="34"
                Margin="0,14,0,0" HorizontalAlignment="Right" Click="Close_Click"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
        </ScrollViewer>
    </DockPanel>
</Window>
